# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- MongoDB (shared by all modules) ----
# Atlas (recommended — transactions work out of the box):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local single-node replica set:
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=retailhub_db

# ---- Auth (must be the SAME secret Person 4 uses to sign tokens) ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ---- Module 1 ----
EXPIRY_WARNING_DAYS=30
ENABLE_JOBS=true

# DEV ONLY: lets you get a test token at POST /api/dev/token before real login exists.
# Set to false (or delete) once Person 4's auth is integrated. Never true in production.
ENABLE_DEV_AUTH=true
